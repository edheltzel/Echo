{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "exclude": [
    "node_modules",
    "site",
    "adapters/pi",
    "adapters/omp",
    "tests/adapters/pi",
    "tests/adapters/omp"
  ]
}
