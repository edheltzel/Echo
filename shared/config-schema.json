{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/config-schema.json",
  "title": "Echo configuration",
  "description": "Flat Echo settings. Values may be strings, booleans, or numbers; secrets are never stored here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PORT": { "type": ["string", "integer"], "minimum": 0, "maximum": 65535, "default": 3246 },
    "VOICES_PATH": { "type": "string" },
    "PRONUNCIATIONS_PATH": { "type": "string" },
    "ECHO_VOICE_PERSONA_NAME": { "type": "string" },
    "ECHO_VOICE_ID": { "type": "string" },
    "ECHO_VOICE_TITLE": { "type": "string" },
    "ECHO_VOICE_CATCHPHRASE": { "type": "string" },
    "ECHO_VOICE_ENABLED": { "type": ["string", "boolean"] },
    "ECHO_VOICE_GREET_ON_START": { "type": ["string", "boolean"] },
    "ECHO_VOICE_SPEAK_COMPLETIONS": { "type": ["string", "boolean"] },
    "ECHO_VOICE_SUPPRESS": { "type": ["string", "boolean"] },
    "ECHO_VOICE_SUPPRESS_SUBAGENTS": { "type": ["string", "boolean"] },
    "ECHO_DEFAULT_TITLE": { "type": "string" },
    "ECHO_EDGETTS_TIMEOUT_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_EDGETTS_TIMEOUT_MAX_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_EDGETTS_TIMEOUT_PER_CHAR_MS": { "type": ["string", "integer"], "minimum": 0 },
    "ECHO_EDGETTS_HEALTH_TIMEOUT_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_EDGETTS_SYNTH_RETRIES": { "type": ["string", "integer"], "minimum": 0 },
    "ECHO_EDGETTS_SYNTH_BACKOFF_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_CIRCUIT_BREAKER_THRESHOLD": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_PLAY_QUEUE_MAX_DEPTH": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_PLAY_QUEUE_AGE_CAP_MS": { "type": ["string", "integer"], "minimum": 1000 },
    "ECHO_PLAY_QUEUE_PLAYER_TIMEOUT_MS": { "type": ["string", "integer"], "minimum": 1000 },
    "ECHO_AUDIO_PROCESS_TIMEOUT_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_NOTIFICATION_PROCESS_TIMEOUT_MS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_TTS_CACHE_DIR": { "type": "string" },
    "ECHO_TTS_CACHE_MAX_BYTES": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_TTS_CACHE_MAX_TEXT_CHARS": { "type": ["string", "integer"], "minimum": 1 },
    "ECHO_AUDIO_CACHE_DIR": { "type": "string" },
    "ECHO_MUTE_STATE_PATH": { "type": "string" },
    "ECHO_CAPTURE_STATE_PATH": { "type": "string" },
    "ECHO_AUDIO_LIFECYCLE_LOG": { "type": "string" },
    "ECHO_AUDIO_LIFECYCLE_LOG_MAX_BYTES": { "type": ["string", "integer"], "minimum": 1024 },
    "ECHO_RESOLUTION_LOG": { "type": "string" },
    "ECHO_RESOLUTION_LOG_MAX_BYTES": { "type": ["string", "integer"], "minimum": 1024 },
    "ECHO_VOICE_EVENTS_LOG": { "type": "string" },
    "ECHO_DAEMON_URL": { "type": "string" },
    "ECHO_NOTIFY_URL": { "type": "string" },
    "ECHO_VOICE_SURFACES": { "type": "string" }
  }
}
